# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (MySQL)
DATABASE_URL="Server=localhost;Port=3306;Database=billmate_db;User=root;Password=your_secure_password;"
DATABASE_URL_STAGE="Server=localhost;Port=3306;Database=billmate_stage_db;User=root;Password=your_secure_password;"

# JWT Authentication
JWT_SECRET="YourSuperSecretLongKeyForJwtSigningAtLeast32Chars!"
JWT_ISSUER="https://localhost:3000"
JWT_AUDIENCE="https://localhost:5173"
JWT_EXPIRY=2

# MailerSend (Email Service)
MAILERSEND_API_KEY="mlsn.your_mailersend_api_key_here"
MAILERSEND_EMAIL_CON_TEMPLATE_ID="your_email_confirmation_template_id"
MAILERSEND_PASSWORD_RESET_TEMPLATE_ID="your_password_reset_template_id"

# Shopier (Payment Gateway)
SHOPIER_API_KEY="your_shopier_api_key"
SHOPIER_API_SECRET="your_shopier_api_secret"

# Webhook / Basic Auth credentials
OSB_USER_NAME="admin"
OSB_PASSWORD="your_webhook_password"
